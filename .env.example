# Humiq Loop - Environment Variables
# Copy this file to .env and fill in your values

# API Backend URL (the NestJS API, default: http://localhost:4000/api)
VITE_API_URL=http://localhost:4000/api

# Voice interviews: WebSocket URL of the Gemini Live voice relay. Leave blank to disable voice.
VITE_VOICE_RELAY_URL=ws://localhost:8768
